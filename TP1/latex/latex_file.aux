\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces plot multi con sps=2, span=6, rrc=True. La baja resolución distorsiona la forma del filtro para todos los valores de $\alpha $.}}{4}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces plot multi con sps=4, span=6, rrc=True. Se comienza a distinguir la forma característica del filtro.}}{5}{}\protected@file@percent }
